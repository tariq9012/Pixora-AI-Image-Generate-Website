# Copy to .env (local) and fill in real values. NEVER commit .env.
# In Vercel, set these in Project Settings -> Environment Variables
# (separately for Development / Preview / Production).
# Nothing here uses a VITE_ prefix on purpose: every value below is a
# SERVER-ONLY value. A VITE_-prefixed variable would be embedded in the
# browser bundle.

# ------------------------------------------------------------------ App
# development | test | production   (Vercel sets production automatically)
NODE_ENV=development
# Public origin used in emails and Stripe return URLs.
# Production MUST be the real https:// origin (no localhost, no port 5173).
APP_URL=http://localhost:5173

# ------------------------------------------------------------- Database
# SERVER SECRET. Use Neon's DIRECT (non-pooler) string with the postgres.js
# driver unless you have re-run the credit/generation regression tests
# against a pooled string (see docs/PRODUCTION.md, "Neon strategy").
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ----------------------------------------------------------------- Auth
# Sessions are opaque DB-backed tokens in an HttpOnly cookie; there is no
# JWT/session-signing secret to configure.

# ---------------------------------------------------------------- Email
# SERVER SECRET. REQUIRED in production (the console fallback is disabled).
# Leave blank locally to use the console email fallback. Example EMAIL_FROM:
#   Pixora AI <no-reply@your-domain.example>
RESEND_API_KEY=
EMAIL_FROM=

# ------------------------------------------------------- Cloudflare AI
AI_PROVIDER=cloudflare-workers-ai
CLOUDFLARE_ACCOUNT_ID=
# SERVER SECRET, scoped to Workers AI only.
CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------- Storage / R2
# local = development only (writes ./storage/dev). Production MUST be s3.
STORAGE_PROVIDER=local
# Cloudflare R2 example: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
# SERVER SECRETS
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# In s3 mode the BROWSER uploads straight to <S3_ENDPOINT> with a short-lived
# presigned URL (Phase 14A), so the bucket needs a CORS rule for your app origin
# and the token needs Object Read & Write. See docs/PRODUCTION.md.
# Public origin that serves public assets (avatars, covers, generated
# outputs), e.g. a custom domain bound to the bucket.
S3_PUBLIC_BASE_URL=

# --------------------------------------------------------------- Stripe
# SERVER SECRETS. Use sk_test_ / test Price IDs everywhere except Production.
# The webhook secret comes from `stripe listen` (local) or the Stripe
# Dashboard webhook endpoint (deployed): https://<domain>/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_CREATOR_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_CREDIT_PACK_CURRENCY=usd

# ------------------------------------------------ Production configuration
# Local ONNX tools (Background Removal, Upscale). Default: on in development,
# OFF in production. Set true ONLY on a persistent Node/container/VPS host
# with a writable model cache; never on Vercel Functions.
# LOCAL_ONNX_ENABLED=false
# LOCAL_MODEL_CACHE_DIR=/var/cache/pixora/models
#
# Max multipart upload accepted through the app server, in bytes.
# Production default: 4194304 (4 MB, under Vercel's ~4.5 MB body limit).
# UPLOAD_PROXY_MAX_BYTES=4194304
# optional: DB_POOL_MAX=3

# ------------------------------------------- Stale generation cleanup (14B)
# SERVER SECRET, min 32 chars. REQUIRED in production. Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>" to /api/cron/cleanup-generations.
# Generate one:  openssl rand -hex 32
CRON_SECRET=
# Minutes before a PROCESSING (or QUEUED) generation counts as stranded.
# Integer 5-240. Default 15.
# GENERATION_STALE_MINUTES=15
